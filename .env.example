# Copy to .env.local. Server only: never prefix these with NEXT_PUBLIC_.
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.6-pro
# For Token Plan, use the OpenAI-compatible Base URL supplied by its console.

# Local pet generator: directory containing outputs/PetStudio and outputs/Pet_Model_Selection.
PET_AGENT_LIBRARY=
# Empty selects the project .venv on Windows, then falls back to python on PATH.
PET_AGENT_PYTHON=
PET_AGENT_CHROME=C:/Program Files/Google/Chrome/Application/chrome.exe
# Optional: independently choose the pet recognition model; defaults to MIMO_MODEL.
PET_MIMO_MODEL=
